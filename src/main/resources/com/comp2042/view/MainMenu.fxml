<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="backgroundPane" maxHeight="400.0" maxWidth="550.0" minHeight="400.0" minWidth="550.0" prefHeight="400.0" prefWidth="550.0" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.comp2042.controller.MainMenuController">
    <stylesheets>
        <URL value="@styling.css" />
    </stylesheets>
    <children>
        <StackPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <VBox fx:id="menuContent" alignment="CENTER" fillWidth="false" spacing="14.0" maxHeight="-Infinity">
                    <children>
                        <StackPane prefWidth="440.0">
                            <padding><Insets bottom="7.0" /></padding>
                            <children>
                                <Label id="title" alignment="CENTER" contentDisplay="CENTER" text="Snake Game" textAlignment="CENTER" />
                                <Label fx:id="menuSplash" StackPane.alignment="BOTTOM_RIGHT" translateY="-5" rotate="-15.0" mouseTransparent="true" />
                            </children>
                        </StackPane>
                        <VBox alignment="CENTER" fillWidth="false" spacing="8.0">
                            <children>
                                <Label alignment="CENTER" styleClass="modeLabel" text="Game Mode" labelFor="${modeSelector}" />
                                <ComboBox fx:id="modeSelector" prefHeight="36.0" prefWidth="220.0" styleClass="modeSelector" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" fillWidth="false" spacing="12.0">
                            <children>
                                <Button fx:id="btn_start" prefHeight="40.0" prefWidth="180.0" mnemonicParsing="false" onAction="#handleStart" styleClass="menuButton" text="Start" />
                                <Button fx:id="btn_help" prefHeight="40.0" prefWidth="180.0" mnemonicParsing="false" onAction="#handleHowToPlay" styleClass="menuButton" text="How to Play" />
                                <Button fx:id="btn_leaderboards" prefHeight="40.0" prefWidth="180.0" mnemonicParsing="false" onAction="#handleLeaderboards" styleClass="menuButton" text="Leaderboards" />
                                <Button fx:id="btn_exit" prefHeight="40.0" prefWidth="180.0" mnemonicParsing="false" onAction="#handleExit" styleClass="menuButton" text="Exit" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>
